# Copy this file to .env and replace every placeholder before starting.
# Use a long, unique random value. Never commit the real .env file.
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/complaints.sqlite
UPDATE_PUBLIC_KEY_PATH=./data/trusted-update-public.pem

# Optional email (disabled by default — leave empty for offline-only)
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=complaints@example.com
# NOTIFY_ADMIN_EMAIL=admin@example.com
