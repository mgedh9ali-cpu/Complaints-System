# للتشغيل من المصدر: node scripts/initialize-local-config.js
# لا ترفع .env أو مفاتيح الاستعادة إلى المستودع.
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_KEY=replace-with-a-separate-random-storage-key-of-32-characters
BACKUP_SECRET=replace-with-a-separate-random-backup-key-of-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/complaints.sqlite
UPDATE_PUBLIC_KEY_PATH=./data/trusted-update-public.pem
# مسار اختياري لنسخ منفصلة عن جهاز البيانات؛ لا تغيّر المفاتيح بعد إنشاء البيانات.
# BACKUP_DIR=D:/Complaints-Backups
