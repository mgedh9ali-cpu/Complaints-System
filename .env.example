# انسخ هذا الملف إلى .env وعدّل القيم قبل التشغيل.
# لا ترفع ملف .env الحقيقي إلى Git.
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/complaints.sqlite
UPDATE_PUBLIC_KEY_PATH=./data/trusted-update-public.pem
# AUTO_BACKUP_HOURS=6
# Optional: separate key for encrypted backups (defaults to SESSION_SECRET)
# BACKUP_SECRET=replace-with-another-long-random-secret
