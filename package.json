{
  "name": "complaints-local-system",
  "version": "0.5.0",
  "private": true,
  "description": "Local-first Arabic complaints system with attachments, Excel export, PWA, CSRF, persistent sessions",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "test": "node --test",
    "check": "node --check server.js app.js",
    "verify-audit": "node scripts/verify-audit-log.js",
    "backup": "node scripts/backup-database.js",
    "check:all": "npm test && npm audit && npx jscpd . --ignore \"node_modules,package-lock.json,.git\""
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.1",
    "session-file-store": "^1.5.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
