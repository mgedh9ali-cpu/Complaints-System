{
  "name": "complaints-local-system",
  "version": "1.0.0-rc.4",
  "private": true,
  "description": "Local-first Arabic complaints system for private office use",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "start:desktop": "electron .",
    "test": "node --test --test-concurrency=4",
    "check": "node scripts/check-source.js",
    "check:sqlite": "node -e \"const Database = require('better-sqlite3'); const db = new Database(':memory:'); console.log(db.prepare('SELECT sqlite_version() AS version').get()); db.close();\"",
    "postinstall": "node -e \"try{require('child_process').execSync('npx electron-builder install-app-deps',{stdio:'inherit',shell:true})}catch(e){console.warn('[postinstall] Electron native rebuild skipped:', e.message); process.exit(0)}\"",
    "verify-audit": "node scripts/verify-audit-log.js",
    "backup": "node scripts/backup-database.js",
    "dist:win": "electron-builder --win portable --x64"
  },
  "engines": {
    "node": ">=22 <26"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "call-bind-apply-helpers": "^1.0.2",
    "exceljs": "^4.4.0",
    "jszip": "3.10.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "session-file-store": "^1.5.0",
    "glob": "file:vendor/glob-compat",
    "minimatch": "file:vendor/minimatch-compat",
    "rimraf": "file:vendor/rimraf-compat"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "local.complaints.system",
    "productName": "نظام الشكاوى",
    "directories": {
      "output": "dist-desktop"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/better-sqlite3/**/*"
    ],
    "files": [
      "desktop/**/*",
      "modules/**/*",
      "lib/**/*",
      "config/**/*",
      "ui/**/*",
      "scripts/**/*",
      "vendor/**/*",
      "assets/**/*",
      "server.js",
      "app.js",
      "index.html",
      "manifest.json",
      "package.json",
      "*.css",
      "sw.js",
      "sw-register.js",
      "ui-enhancements.js",
      "attachments-ui-bridge.js",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/.bin",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!dist-desktop",
      "!.env",
      "!.env.*",
      "!data/**/*",
      "!*.db",
      "!*.sqlite",
      "!logs/**/*",
      "!backups/**/*",
      "assets/fonts/**",
      "!fonts/**/*",
      "!fonts-src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Complaints-System-Portable.${ext}"
    }
  }
}
